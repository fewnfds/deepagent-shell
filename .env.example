# Local single-user settings. The official launchers copy this template to
# data/config/agent-shell.env and ask for the required password on first launch.
# The complete data directory is the persistent instance boundary.
AGENT_SHELL_HOST=127.0.0.1
AGENT_SHELL_PORT=19100
AGENT_SHELL_ALLOW_REMOTE=false
AGENT_SHELL_LANGSMITH_TRACING_ENABLED=false

# Required even for loopback: replace the placeholder with a private password.
# AGENT_SHELL_MANAGEMENT_TOKEN=<generate-a-management-token>

# Set the /v1 API Key on the API Server page. It is stored in the instance database.
# Agent Shell remains an HTTP backend; expose it remotely only through an
# external TLS reverse proxy and firewall. Never commit the resulting file.
# AGENT_SHELL_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# CORS is disabled when omitted. Use exact HTTP(S) origins; wildcard is rejected.
# AGENT_SHELL_CORS_ORIGINS=https://console.example.invalid
